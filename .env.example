# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local dev. On Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview).
#
# IMPORTANT: the VITE_* values are inlined into the browser bundle at BUILD
# time. They must exist in Vercel *before* the build runs, or the app throws
# "Missing Supabase environment variable(s)" on every page load.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Dashboard → Settings → API) ────────────────────────────────────
# Safe to expose: the publishable/anon key is guarded by Row Level Security.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# SECRET — full database access, bypasses RLS. Server-side only.
# NEVER prefix this with VITE_, or it ships to the browser.
# Required for: admin analytics, admin-managed API keys, Office text
# extraction, and AI rate limiting.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by the Supabase CLI for migrations — not needed on Vercel.
SUPABASE_DB_PASSWORD=

# ── Gemini (https://aistudio.google.com/apikey) ──────────────────────────────
# GEMINI_API_KEY is required. _2.._10 are optional and rotated automatically.
# Free tier is ~20 requests/day PER GOOGLE CLOUD PROJECT, so extra keys only
# add quota if each is created in a DIFFERENT project.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# ── YouTube Data API v3 (Google Cloud → APIs → YouTube Data API v3) ──────────
# Powers video search. _2.._5 are rotated when a key hits its quota.
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=
YOUTUBE_API_KEY_5=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Only needed if you turn Supabase email confirmations back on.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
